 "cells": [
  {"cell_type":"markdown","metadata":{},"source":["# 📱 Pocket OTC AI Analyzer — One-Click APK Builder\n","\n","شغّل خلية البناء الوحيدة أدناه فقط. تقوم تلقائيًا بتنزيل المشروع من GitHub، وتجهيز Java وAndroid SDK وGradle، ثم بناء APK وتنزيله.\n","\n","READ-ONLY: التطبيق لا يسجل الدخول إلى Pocket Option ولا ينفذ صفقات."]},
  {"cell_type":"code","metadata":{},"execution_count":null,"outputs":[],"source":["# 🚀 ONE-CLICK APK BUILDER — شغّل هذه الخلية فقط\n","import os, shutil, subprocess, traceback, zipfile, stat, glob\n","\n","REPO='https://github.com/mohmb142/Jjjjjjj.git'\n","ZIP_URL='https://github.com/mohmb142/Jjjjjjj/archive/refs/heads/main.zip'\n","ROOT='/content/Jjjjjjj'\n","ANDROID=os.path.join(ROOT,'phone-agent')\n","GRADLE_VERSION='8.7'\n","SDK_API='35'\n","BUILD_TOOLS='35.0.0'\n","\n"],
  {"cell_type":"code","metadata":{},"execution_count":null,"outputs":[],"source":["# ⬇️ لا تعدّل شيئًا — هذه هي خلية البناء الوحيدة المطلوبة\n","import os, shutil, subprocess, traceback, zipfile, stat, glob\n","\n","REPO='https://github.com/mohmb142/Jjjjjjj.git'\n","ZIP_URL='https://github.com/mohmb142/Jjjjjjj/archive/refs/heads/main.zip'\n","ROOT='/content/Jjjjjjj'\n","ANDROID=os.path.join(ROOT,'phone-agent')\n","GRADLE_VERSION='8.7'\n","SDK_API='35'\n","BUILD_TOOLS='35.0.0'\n","\n","def run(cmd, cwd=None, timeout=600, env=None, check=True):\n","    print('▶️', ' '.join(map(str, cmd)))\n","    p=subprocess.run(cmd,cwd=cwd,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=timeout)\n","    if p.stdout: print(p.stdout[-8000:])\n","    if check and p.returncode!=0: raise RuntimeError(f'Command failed ({p.returncode}): {cmd}')\n","    return p\n","\n","try:\n","    os.chdir('/content')\n","    if os.path.exists(ROOT): shutil.rmtree(ROOT,ignore_errors=True)\n","    print('1/6 ⬇️ تنزيل المشروع...')\n","    clone=subprocess.run(['git','clone','--depth','1',REPO,ROOT],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=180)\n","    if clone.returncode!=0:\n","        print(clone.stdout)\n","        print('⚠️ git clone فشل، استخدام ZIP...')\n","        zp='/content/Jjjjjjj.zip'\n","        run(['wget','-q','-O',zp,ZIP_URL],timeout=240)\n","        tmp='/content/Jjjjjjj-main'\n","        if os.path.exists(tmp): shutil.rmtree(tmp,ignore_errors=True)\n","        with zipfile.ZipFile(zp) as z: z.extractall('/content')\n","        if not os.path.isdir(tmp): raise RuntimeError('لم يتم استخراج مشروع GitHub')\n","        os.rename(tmp,ROOT)\n","    os.chdir('/content')\n","    if not os.path.isfile(os.path.join(ANDROID,'app','build.gradle.kts')):\n","        raise RuntimeError('مشروع Android غير موجود في phone-agent/app/')\n","\n","    print('2/6 ☕ تجهيز Java 17...')\n","    java_candidates=[os.environ.get('JAVA_HOME'),'/usr/lib/jvm/java-17-openjdk-amd64','/usr/lib/jvm/java-21-openjdk-amd64','/usr/lib/jvm/default-java']\n","    java=None\n","    for p in java_candidates:\n","        if p and os.path.isfile(os.path.join(p,'bin','java')) and os.path.isfile(os.path.join(p,'bin','javac')):\n","            java=p; break\n","    if java is None:\n","        run(['apt-get','update','-qq'],timeout=300,check=False)\n","        run(['apt-get','install','-y','-qq','openjdk-17-jdk','wget','unzip'],timeout=600)\n","        java='/usr/lib/jvm/java-17-openjdk-amd64'\n","    os.environ['JAVA_HOME']=java\n","    os.environ['PATH']=java+'/bin:'+os.environ.get('PATH','')\n","    j=run(['java','-version'],cwd='/content',timeout=60)\n","    if j.returncode!=0: raise RuntimeError('Java غير صالح')\n","    run(['javac','-version'],cwd='/content',timeout=60)\n","\n","    print('3/6 📱 تجهيز Android SDK تلقائيًا...')\n","    # أولًا نبحث عن SDK صالح يحتوي على sdkmanager. مجرد وجود المجلد لا يكفي.\n","    sdk_candidates=[\n","        os.environ.get('ANDROID_SDK_ROOT'),\n","        os.environ.get('ANDROID_HOME'),\n","        '/usr/local/lib/android/sdk',\n","        '/opt/android-sdk',\n","        '/content/android-sdk'\n","    ]\n","    sdk=None\n","    sdkmanager=None\n","    for p in sdk_candidates:\n","        if not p: continue\n","        for sm in [os.path.join(p,'cmdline-tools','latest','bin','sdkmanager'),os.path.join(p,'cmdline-tools','bin','sdkmanager'),os.path.join(p,'tools','bin','sdkmanager')]:\n","            if os.path.isfile(sm):\n","                sdk=p; sdkmanager=sm; break\n","        if sdkmanager: break\n","\n","    if sdkmanager is None:\n","        print('📥 تنزيل Android Command Line Tools...')\n","        sdk='/content/android-sdk'\n","        os.makedirs(sdk,exist_ok=True)\n","        cmdzip='/content/commandlinetools.zip'\n","        cmdurl='https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip'\n","        run(['wget','-q','-O',cmdzip,cmdurl],timeout=360)\n","        tmp='/content/cmdline-tools-tmp'\n","        if os.path.exists(tmp): shutil.rmtree(tmp,ignore_errors=True)\n","        os.makedirs(tmp,exist_ok=True)\n","        with zipfile.ZipFile(cmdzip) as z: z.extractall(tmp)\n","        latest=os.path.join(sdk,'cmdline-tools','latest')\n","        os.makedirs(os.path.dirname(latest),exist_ok=True)\n","        if os.path.exists(latest): shutil.rmtree(latest,ignore_errors=True)\n","        os.rename(os.path.join(tmp,'cmdline-tools'),latest)\n","        sdkmanager=os.path.join(latest,'bin','sdkmanager')\n","\n","    if not os.path.isfile(sdkmanager): raise RuntimeError('لم يتم العثور على sdkmanager')\n","    os.chmod(sdkmanager,os.stat(sdkmanager).st_mode|stat.S_IXUSR|stat.S_IXGRP|stat.S_IXOTH)\n","    os.environ['ANDROID_HOME']=sdk\n","    os.environ['ANDROID_SDK_ROOT']=sdk\n","    os.environ['PATH']=os.path.dirname(sdkmanager)+':'+os.path.join(sdk,'platform-tools')+':'+os.environ.get('PATH','')\n","    print('ANDROID_SDK_ROOT:',sdk)\n","    print('sdkmanager:',sdkmanager)\n","\n","    # قبول الرخص ثم تثبيت المكونات المطلوبة. نستخدم --sdk_root لتجنب مشكلة مسار SDK.\n","    lic=subprocess.run(['bash','-lc',f\"yes | '{sdkmanager}' --sdk_root='{sdk}' --licenses >/dev/null 2>&1\"],cwd='/content',stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=240)\n","    print('SDK licenses exit:',lic.returncode)\n","    run([sdkmanager,'--sdk_root='+sdk,'platform-tools',f'platforms;android-{SDK_API}',f'build-tools;{BUILD_TOOLS}'],cwd='/content',timeout=1200)\n","\n","    # الحل الحاسم للخطأ الذي ظهر: Gradle سيقرأ هذا الملف مباشرة.\n","    local_props=os.path.join(ANDROID,'local.properties')\n","    with open(local_props,'w',encoding='utf-8') as f:\n","        f.write('sdk.dir='+sdk.replace('\\\\','/')+'\\n')\n","    print('✅ local.properties:',local_props)\n","\n","    print('4/6 📦 تجهيز Gradle...')\n","    gradle_bin=f'/content/gradle-{GRADLE_VERSION}/bin/gradle'\n","    if not os.path.isfile(gradle_bin):\n","        gz=f'/content/gradle-{GRADLE_VERSION}-bin.zip'\n","        run(['wget','-q',f'https://services.gradle.org/distributions/gradle-{GRADLE_VERSION}-bin.zip','-O',gz],timeout=360)\n","        with zipfile.ZipFile(gz) as z: z.extractall('/content')\n","    if not os.path.isfile(gradle_bin): raise RuntimeError('Gradle غير موجود')\n","    os.chmod(gradle_bin,os.stat(gradle_bin).st_mode|stat.S_IXUSR|stat.S_IXGRP|stat.S_IXOTH)\n","    run([gradle_bin,'--version'],cwd='/content',timeout=120)\n","\n","    print('5/6 🔨 بناء APK...')\n","    build_log='/content/pocket_otc_gradle_build.log'\n","    env=os.environ.copy()\n","    env['JAVA_HOME']=java\n","    env['ANDROID_HOME']=sdk\n","    env['ANDROID_SDK_ROOT']=sdk\n","    env['GRADLE_OPTS']='-Xmx2g -Dfile.encoding=UTF-8'\n","    with open(build_log,'w',encoding='utf-8') as log:\n","        build=subprocess.run([gradle_bin,'assembleDebug','--no-daemon','--stacktrace'],cwd=ANDROID,env=env,stdout=log,stderr=subprocess.STDOUT,text=True,timeout=1800)\n","    with open(build_log,'r',encoding='utf-8',errors='replace') as f: content=f.read()\n","    print('\\n========== آخر سجل Gradle ==========' )\n","    print(content[-16000:])\n","    if build.returncode!=0: raise RuntimeError(f'Gradle فشل — exit code {build.returncode}')\n","\n","    print('6/6 📱 التحقق والتنزيل...')\n","    apk=os.path.join(ANDROID,'app','build','outputs','apk','debug','app-debug.apk')\n","    if not os.path.isfile(apk) or os.path.getsize(apk)==0: raise RuntimeError('تم إنهاء Gradle لكن APK غير موجود')\n","    size=os.path.getsize(apk)/1024/1024\n","    print(f'✅ APK جاهز: {apk}')\n","    print(f'📦 الحجم: {size:.2f} MB')\n","    from google.colab import files\n","    files.download(apk)\n","    print('🎉 تم إنشاء APK بنجاح — بدون Telegram — Android 8+ / Android 10 مدعوم.')\n","except Exception:\n","    print('\\n❌ فشل البناء:')\n","    traceback.print_exc()\n","    print('\\n💡 إذا فشل مرة أخرى، انسخ آخر 100 سطر من الخطأ فقط.')"]}
 ],
